# Copy this file to .env and fill in your values

# REQUIRED: Generate a strong random key for production
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hosts (your domain or localhost)
ALLOWED_HOSTS=localhost,127.0.0.1

# Email settings (optional — used for contact form and waitlist notifications)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-api-key
# DEFAULT_FROM_EMAIL=noreply@yourconference.network
# CONTACT_EMAIL=hello@yourconference.network
