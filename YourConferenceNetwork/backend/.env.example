# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Django
DJANGO_SECRET_KEY=django-insecure-replace-this-with-a-long-random-string

# Stripe — get these from https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook secret — from https://dashboard.stripe.com/webhooks
# When testing locally: stripe listen --forward-to localhost:8000/api/v1/billing/webhook/
STRIPE_WEBHOOK_SECRET=whsec_...

# Redis (required in production; dev uses CELERY_TASK_ALWAYS_EAGER instead)
# CELERY_BROKER_URL=redis://localhost:6379/0
