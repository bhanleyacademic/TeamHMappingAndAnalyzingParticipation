# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Django
DJANGO_SECRET_KEY=django-insecure-replace-this-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Stripe (get these from https://dashboard.stripe.com/apikeys)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook secret (from https://dashboard.stripe.com/webhooks)
# When testing locally: stripe listen --forward-to localhost:8000/api/v1/billing/webhook/
STRIPE_WEBHOOK_SECRET=whsec_...

# PostgreSQL (production only; dev uses SQLite)
DB_NAME=yourconferencenetwork
DB_USER=ycn
DB_PASSWORD=changeme

# Redis (production only; dev runs tasks synchronously without Redis)
# CELERY_BROKER_URL=redis://redis:6379/0
